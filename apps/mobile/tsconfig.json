{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Hermes stops at ES2022: `toSorted` and its change-by-copy siblings compile and then throw
    // on the device. Capping the lib turns that crash into a type error.
    "lib": ["DOM", "ES2022"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    },
    "moduleSuffixes": [".native", ""]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
