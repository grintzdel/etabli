{
  "name": "etabli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:packages": "pnpm --filter \"./packages/**\" --if-present run build",
    "check": "pnpm run build:packages && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:generate:api": "pnpm --filter @etabli/api run db:generate",
    "db:migrate": "pnpm --filter @etabli/server run db:migrate",
    "db:migrate:api": "pnpm --filter @etabli/api run db:migrate",
    "db:migrate:test": "pnpm --filter @etabli/server run db:migrate:test",
    "db:migrate:test:api": "pnpm --filter @etabli/api run db:migrate:test",
    "db:seed": "pnpm --filter @etabli/server run db:seed",
    "db:seed:api": "pnpm --filter @etabli/api run db:seed",
    "db:seed:test": "pnpm --filter @etabli/server run db:seed:test",
    "db:seed:test:api": "pnpm --filter @etabli/api run db:seed:test",
    "db:test:down": "docker compose down",
    "db:test:up": "docker compose up -d --wait postgres && ([ -f .env.test ] || cp .env.test.example .env.test)",
    "dev": "sh ./scripts/dev.sh",
    "dev:api": "pnpm --filter @etabli/api run dev",
    "dev:mobile": "pnpm --filter @etabli/mobile run start",
    "dev:server": "pnpm --filter @etabli/server run dev",
    "dev:web": "pnpm --filter @etabli/web run dev",
    "format": "oxfmt --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm --filter @etabli/web run test:e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --build --verbose && pnpm --filter @etabli/ui run typecheck && pnpm --filter @etabli/api run typecheck && pnpm --filter @etabli/web run typecheck && pnpm --filter @etabli/mobile run typecheck",
    "verify": "pnpm run check && pnpm --filter @etabli/web run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
